@using Quoridor.ViewModels.Forms
@inject IPlayerService playerService
@inject IJSRuntime JS
@if (Loading) { <p class="loading-state" role="status">A fresh board is on its way…</p> }
else if (barrierActive)
{
    <section class="form-panel" aria-labelledby="name-heading"><p class="eyebrow">Welcome to the table</p><h2 id="name-heading">Take your seat.</h2><p>Pick a display name. Your moves, wins and a little friendly rivalry start here.</p>
        <EditForm Model="userNameForm" OnSubmit="Submit"><label for="player-name">What should we call you?</label><InputText id="player-name" maxlength="40" autocomplete="nickname" placeholder="Your display name" @bind-Value="userNameForm.UserName" />
            @if (error is not null) { <p role="alert">@error</p> }
            <button type="submit">Join the game <span aria-hidden="true">↗</span></button>
        </EditForm><p class="microcopy">No account needed. This browser remembers your player.</p>
    </section>
}
else { @ChildContent }

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    UserNameForm userNameForm = new();
    Player? player;
    bool barrierActive = true;
    bool Loading = true;
    string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (playerService is null)
                return;
            player = (await playerService.GetPlayer());
            userNameForm.UserName = player?.UserName ?? string.Empty;
            if (player is null) userNameForm.UserName = await JS.InvokeAsync<string>("GetLegacyName");
            barrierActive = player is null;
            Loading = false;
            StateHasChanged();
        }
    }

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(userNameForm.UserName))
            return;
        try
        {
            await playerService.SetUser(userNameForm.UserName.Trim());
            barrierActive = false;
        }
        catch (ArgumentException) { error = "Use a name between 1 and 40 characters without control characters."; }
    }
}
