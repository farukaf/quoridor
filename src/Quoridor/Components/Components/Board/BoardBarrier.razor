@inject IPlayerService playerService
@code {
    [Parameter] public RoomViewModel Room { get; set; } = default!;
    private Player? player;
    protected override async Task OnInitializedAsync() => player = await playerService.GetPlayer();
}
@if (Room.Player2 is null) { <p class="board-notice">An open seat, a fresh board. Invite a friend to get started.</p> }
else if (Room.Board.CurrentPlayer?.Id != player?.Id) { <p class="board-notice">Watch the board. Your next idea can start while you wait.</p> }
