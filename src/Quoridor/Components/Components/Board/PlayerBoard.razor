@inject IPlayerService playerService
<section class="side-card" aria-labelledby="players-heading">
    <h2 id="players-heading">The players</h2>
    <ul class="player-list">
    @foreach (var entry in new[] { (View: Room.Player1, Number: 1), (View: Room.Player2, Number: 2) })
    {
        var view = entry.View;
        <li class="@(entry.Number == 1 ? "player-one" : "player-two") @(view is not null && Room.Board.CurrentPlayer == view ? "active" : "") @(view is null ? "waiting-player" : "")">
            <small>Player @entry.Number</small>
            <strong>@(view?.Name ?? "An open seat")</strong>
            @if (view is not null && Room.Board.CurrentPlayer == view) { <small class="turn-pill">TURN</small> }
            <ul>
                <li>@if (view is not null && player?.Id == view.Id) { <small class="you-pill">YOU</small> } else { <span>@(view is null ? "Share your room link" : "Opponent")</span> }</li>
                @if (view is not null) { <li>Walls: @view.WallCount</li> }
            </ul>
        </li>
    }
    </ul>
</section>
