@code { [Parameter] public RoomViewModel Room { get; set; } = default!; }
@if (Room.Victories.Any())
{
    <section class="side-card" aria-label="This room's results"><h2>Well played.</h2><ul class="session-list">@foreach (var victory in Room.Victories.Reverse()) { <li><strong>@victory.PlayerName</strong> won this round<small>@victory.Date.UtcDateTime.ToString("dd MMM · HH:mm") UTC</small></li> }</ul></section>
}
