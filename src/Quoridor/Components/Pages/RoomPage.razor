@page "/Room/{id:guid}"
@using Quoridor.Components.Components.Board
@attribute [StreamRendering]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IRoomService roomService
@inject IPlayerService playerService
@inject ILogger<RoomPage> logger
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Your next move · Quoridor</PageTitle>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private string shareStatus = string.Empty;
    private async Task CopyLink()
    {
        try { await JS.InvokeVoidAsync("CopyRoomLink", Navigation.Uri); shareStatus = "Link copied. Your friend is one click away."; }
        catch (JSException) { shareStatus = "Select the link above and copy it to invite a friend."; }
    }
    private bool wallMode;
    private string? pendingFocus;
    private Task FocusPawn() { wallMode = false; pendingFocus = "pawn"; return Task.CompletedTask; }
    private Task FocusWall() { wallMode = true; pendingFocus = "wall"; return Task.CompletedTask; }
    private string TurnText
    {
        get
        {
            if (Room?.Player2 is null) return "Waiting for a friend to join";
            if (player is not null && Room.Board.CurrentPlayer?.Id == player.Id) return $"Your move, {player.UserName}.";
            return $"{Room.Board.CurrentPlayer?.Name}'s turn";
        }
    }
    protected RoomViewModel? Room { get; set; }
    private Player? player;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocus is { } kind) { pendingFocus = null; await JS.InvokeVoidAsync("FocusBoardControl", kind); }
        if (!firstRender)
            return;

        await EnterRoom();
        playerService.PlayerChanged += EnterRoom;
    }

    protected async Task EnterRoom()
    {
        try
        {
            Room = roomService.GetRoom(Id);
            player = await playerService.GetPlayer();
            if (player is null)
                return;

            await Room.EnterRoom(player);
            loading = false;
            Room.RoomChanged -= RoomChanged_Event;
            Room.RoomChanged += RoomChanged_Event;

        }
        catch (Exception ex)
        {
            logger.LogError(ex, ex.Message);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task RoomChanged_Event()
    {
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        playerService.PlayerChanged -= EnterRoom;

        if (Room is null)
            return;

        Room.RoomChanged -= RoomChanged_Event;
        if (player is not null)
            await Room.LeaveRoom(player);

        return;
    }
}

<header class="page-heading game-heading">
    <div><a class="breadcrumb" href="/">← Back to the clubhouse</a><p class="eyebrow">Room @Id.ToString("N")[..6]</p><h1>Your next move.</h1><p>A good plan always leaves room for a surprise.</p></div>
    <div class="room-sharing"><label for="room-link">Invite your opponent</label><div class="share-input"><input id="room-link" readonly value="@Navigation.Uri" /><button type="button" @onclick="CopyLink" aria-label="Copy room invitation link">Copy link</button></div><div class="share-status" role="status">@shareStatus</div></div>
</header>
<UserBarrier>
    @if (loading) { <p class="loading-state" role="status">Getting your board ready…</p> }
    @if (!loading && Room is not null)
    {
        <div class="game-layout">
            <section class="board-stage" aria-label="Quoridor game">
                <div class="turn-banner"><span role="status" aria-live="polite" aria-atomic="true">@TurnText</span><span class="live-badge">Live room</span></div>
                <div class="board-tools"><button type="button" aria-pressed="@(!wallMode)" @onclick="FocusPawn">Move a pawn</button><button type="button" aria-pressed="@wallMode" @onclick="FocusWall">Place a wall</button></div>
                <BoardDraw Room="Room" WallMode="wallMode" />
                <p class="board-caption">@(wallMode ? "Wall mode: choose two highlighted wall points." : "Move mode: select your pawn, then an available square.")</p>
                <p id="keyboard-help" class="board-caption">Keyboard: arrow keys explore the board · Enter or Space selects</p>
            </section>
            <aside class="game-sidebar" aria-label="Players and game information">
                <PlayerBoard Room="Room" />
                <details class="side-card rules-details"><summary>A quick reminder</summary><p>Reach the opposite edge first. Each turn, move your pawn or place one of your ten walls. Jump over an adjacent pawn if the way behind it is clear. If it isn't, step diagonally around it.</p><p>Walls cannot cross or overlap, and must leave both players a route to the finish.</p></details>
                <VictoryBoard Room="Room" />
                <SpectatorBoard Room="Room" />
            </aside>
        </div>
    }
</UserBarrier>
