@page "/"
@inject GameStore Store
<PageTitle>Quoridor leaderboard</PageTitle>
<h1>Quoridor</h1>
<p>Welcome. Play a friend and climb the leaderboard.</p>
<NavLink class="nav-link" href="@($"Room/{Guid.NewGuid()}")">Create a room</NavLink>
<p>Share the room address with a friend to play.</p>
<h2>Leaderboard</h2>
@if (leaders.Count == 0)
{
    <p>No completed games yet. Be the first to win!</p>
}
else
{
    <table>
        <thead><tr><th scope="col">Rank</th><th scope="col">Player</th><th scope="col">Wins</th><th scope="col">Games</th></tr></thead>
        <tbody>
        @for (var i = 0; i < leaders.Count; i++)
        {
            var player = leaders[i];
            <tr data-player="@player.PlayerId"><td>@(i + 1)</td><td><a href="@($"Players/{player.PlayerId}")">@player.Name</a></td><td data-wins>@player.Wins</td><td>@player.Games</td></tr>
        }
        </tbody>
    </table>
    <p>Showing up to 100 players, ordered by wins, games and name.</p>
}
@code {
    private IReadOnlyList<LeaderboardEntry> leaders = Array.Empty<LeaderboardEntry>();
    protected override void OnInitialized() => leaders = Store.Leaderboard();
}
